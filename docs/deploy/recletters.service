# Sample systemd unit. The `.deb` produced by sbt-native-packager generates a
# similar unit automatically; this file is for `sbt stage` deployments.
#
# Install to /etc/systemd/system/recletters.service then:
#   systemctl daemon-reload
#   systemctl enable --now recletters

[Unit]
Description=recletters — recommendation-letter collection service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=recletters
Group=recletters
WorkingDirectory=/opt/recletters
# -Dpidfile.path=/dev/null disables Play's RUNNING_PID file. systemd already
# tracks the process, and an unclean stop (reboot, OOM, kill -9) would otherwise
# leave a stale RUNNING_PID that makes every subsequent start abort with
# "This application is already running". See "Recovering after a reboot" in
# docs/operate.md.
ExecStart=/opt/recletters/bin/recletters \
    -Dconfig.file=/etc/recletters/application.conf \
    -Dhttp.port=9000 \
    -Dpidfile.path=/dev/null \
    -J-Xmx512m
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/recletters

[Install]
WantedBy=multi-user.target
