# Copy this file to conf/secrets.conf and fill in the values. Both
# application.conf and secrets.conf are gitignored.
#
# The Play application key signs the session cookie. Generate with
# `openssl rand -base64 32` or `sbt playGenerateSecret`.
play.http.secret.key = "CHANGE_ME_LONG_RANDOM_STRING"

# Database password.
db.default.password = "CHANGE_ME"

# Mailer password (omit if your SMTP relay does not require auth).
# play.mailer.user     = "smtp-user"
# play.mailer.password = "smtp-password"
# play.mailer.port = 587
# play.mailer.tls = true

# Bearer token for /api/* endpoints. Generate with `openssl rand -base64 32`.
api_token = "CHANGE_ME"

# Optional: HotCRP plug-in (if importers.hotcrp.enabled = true). The plug-in
# opens a Play database named "hotcrp", so its JDBC config lives under db.hotcrp.*
# (not importers.hotcrp.db.*). Map HotCRP option ids to referee roles with
# importers.hotcrp.option-mapping.
# importers.hotcrp.enabled = false
# db.hotcrp.driver   = "org.mariadb.jdbc.Driver"
# db.hotcrp.url      = "jdbc:mariadb://localhost/hotcrp"
# db.hotcrp.username = "..."
# db.hotcrp.password = "..."
# importers.hotcrp.option-mapping { 4 = "supervisor", 5 = "external", 6 = "external" }
# Only db.hotcrp.password above is truly secret; the other importers.hotcrp.*
# / db.hotcrp.* settings are non-secret and may equally live in application.conf
# (e.g. importers.hotcrp.paper-url — see application.conf.template).
